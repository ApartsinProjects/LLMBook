flowchart TB
    subgraph NORMAL["<b>Normal Execution</b>"]
        direction LR
        S1["<b>Step 1</b><br/><i>Search Web</i>"]
        S2["<b>Step 2</b><br/><i>Extract Content</i>"]
        S3["<b>Step 3</b><br/><i>LLM Summarize</i>"]
        S4["<b>Step 4</b><br/><i>Final Report</i>"]
        S1 -->|"checkpoint"| S2
        S2 -->|"checkpoint"| S3
        S3 -->|"checkpoint"| S4
    end

    subgraph FAILURE["<b>Crash at Step 3</b>"]
        direction LR
        F1["<b>Step 1</b><br/><i>Recorded</i>"]
        F2["<b>Step 2</b><br/><i>Recorded</i>"]
        FX["<b>Step 3</b><br/><i>CRASH</i>"]
        F1 ~~~ F2
        F2 ~~~ FX
    end

    subgraph RECOVERY["<b>Durable Recovery</b>"]
        direction LR
        R1["<b>Step 1</b><br/><i>Replay from history</i>"]
        R2["<b>Step 2</b><br/><i>Replay from history</i>"]
        R3["<b>Step 3</b><br/><i>Re-execute</i>"]
        R4["<b>Step 4</b><br/><i>Execute</i>"]
        R1 -.->|"skip"| R2
        R2 -.->|"skip"| R3
        R3 -->|"checkpoint"| R4
    end

    NORMAL ~~~ FAILURE
    FAILURE ~~~ RECOVERY

    style NORMAL fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
