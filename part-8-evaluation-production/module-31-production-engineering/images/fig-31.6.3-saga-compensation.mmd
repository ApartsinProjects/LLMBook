flowchart LR
    subgraph FORWARD["<b>Forward Execution</b>"]
        direction TB
        A1["<b>Book Flight</b><br/><i>Success</i>"]
        A2["<b>Book Hotel</b><br/><i>Success</i>"]
        A3["<b>Generate Itinerary</b><br/><i>FAILS</i>"]
        A1 -->|"register: cancel_flight"| A2
        A2 -->|"register: cancel_hotel"| A3
    end

    A3 -->|"trigger compensations"| COMP

    subgraph COMP["<b>Compensation (Reverse Order)</b>"]
        direction TB
        C2["<b>Cancel Hotel</b><br/><i>Undo step 2</i>"]
        C1["<b>Cancel Flight</b><br/><i>Undo step 1</i>"]
        C2 --> C1
    end

    C1 --> ERR["<b>Report Failure</b><br/><i>Clean state restored</i>"]

    style FORWARD fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style COMP fill:#fce4ec,stroke:#c62828,stroke-width:2px,color:#1a1a2e
    style A1 fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style A2 fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style A3 fill:#fce4ec,stroke:#c62828,stroke-width:2px,color:#1a1a2e
    style C1 fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style C2 fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style ERR fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px,color:#1a1a2e
