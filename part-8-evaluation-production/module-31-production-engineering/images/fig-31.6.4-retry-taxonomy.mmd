flowchart TD
    subgraph IMMEDIATE["**Immediate Retry**"]
        direction TB
        I1["Delay: 0s"]
        I2["Best for: network blips"]
        I3["Risk: worsens rate limits"]
    end

    subgraph EXPONENTIAL["**Exponential Backoff**"]
        direction TB
        E1["Delay: 1s, 2s, 4s, 8s"]
        E2["Best for: provider recovery"]
        E3["Risk: thundering herd"]
    end

    subgraph JITTERED["**Jittered Backoff**"]
        direction TB
        J1["Delay: base +/- random"]
        J2["Best for: shared outages"]
        J3["Recommended default"]
    end

    IMMEDIATE -->|"add delay"| EXPONENTIAL -->|"add randomness"| JITTERED

