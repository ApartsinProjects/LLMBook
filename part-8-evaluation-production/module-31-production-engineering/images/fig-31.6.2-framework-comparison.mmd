flowchart TB
    subgraph TEMPORAL["<b>Temporal</b><br/><i>Infrastructure-Level</i>"]
        direction TB
        T1["<b>Temporal Server</b><br/><i>Manages event history</i>"]
        T2["<b>Workers</b><br/><i>Stateless, scalable</i>"]
        T3["<b>Workflows + Activities</b><br/><i>Deterministic / Non-deterministic split</i>"]
        T1 --- T2
        T2 --- T3
    end

    subgraph INNGEST["<b>Inngest</b><br/><i>Event-Driven</i>"]
        direction TB
        I1["<b>Event Bus</b><br/><i>Trigger functions</i>"]
        I2["<b>step.run()</b><br/><i>Per-step checkpointing</i>"]
        I3["<b>Runs in your app</b><br/><i>FastAPI, Flask, Next.js</i>"]
        I1 --- I2
        I2 --- I3
    end

    subgraph LANGGRAPH["<b>LangGraph</b><br/><i>Application-Level</i>"]
        direction TB
        L1["<b>State Graph</b><br/><i>Nodes + edges</i>"]
        L2["<b>Checkpointer</b><br/><i>PostgreSQL, SQLite, Redis</i>"]
        L3["<b>interrupt_before</b><br/><i>Human-in-the-loop</i>"]
        L1 --- L2
        L2 --- L3
    end

    subgraph CHOOSE["<b>Choose Based On</b>"]
        C1["Complex workflows +<br/>strict guarantees"]
        C2["Event-driven +<br/>minimal infrastructure"]
        C3["LangGraph agents +<br/>simple persistence"]
    end

    TEMPORAL -.-> C1
    INNGEST -.-> C2
    LANGGRAPH -.-> C3

