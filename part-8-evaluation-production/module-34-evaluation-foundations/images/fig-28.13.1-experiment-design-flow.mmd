flowchart TB
    subgraph DESIGN["<b>1. Experiment Design</b>"]
        direction LR
        HYP["<b>Hypothesis</b><br/><i>Testable claim</i>"]
        VAR["<b>Variables</b><br/><i>Independent, dependent,<br/>controlled</i>"]
        POWER["<b>Statistical Power</b><br/><i>Sample size, runs,<br/>confidence level</i>"]
        HYP --> VAR --> POWER
    end

    subgraph EXECUTE["<b>2. Execution</b>"]
        direction LR
        SEED["<b>Fix Seeds</b><br/><i>Random, NumPy,<br/>PyTorch, CUDA</i>"]
        RUN["<b>Multiple Runs</b><br/><i>3 to 5 seeds minimum</i>"]
        LOG["<b>Log Everything</b><br/><i>Model version, prompt,<br/>hyperparameters</i>"]
        SEED --> RUN --> LOG
    end

    subgraph ANALYZE["<b>3. Analysis</b>"]
        direction LR
        ABL["<b>Ablations</b><br/><i>Remove one component<br/>at a time</i>"]
        STAT["<b>Statistical Tests</b><br/><i>Confidence intervals,<br/>paired bootstrap</i>"]
        HUMAN["<b>Human Evaluation</b><br/><i>Inter-annotator<br/>agreement</i>"]
        ABL --> STAT --> HUMAN
    end

    subgraph REPORT["<b>4. Reporting</b>"]
        direction LR
        RESULTS["<b>Results + Error Bars</b><br/><i>Mean, std, CI</i>"]
        ARTIFACTS["<b>Artifact Package</b><br/><i>Code, data, configs,<br/>model checkpoints</i>"]
        RESULTS --> ARTIFACTS
    end

    DESIGN --> EXECUTE --> ANALYZE --> REPORT

    style DESIGN fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
