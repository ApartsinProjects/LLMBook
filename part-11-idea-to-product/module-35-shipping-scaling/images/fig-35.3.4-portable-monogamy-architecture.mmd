flowchart TB
    APP["Application Code"]
    INTF["LLM Interface\nPortableLLM ABC"]

    subgraph PROVIDERS["Provider Adapters (swappable)"]
        OAI["OpenAI Adapter"]
        ANT["Anthropic Adapter"]
        GOO["Google Adapter"]
        OSS["OSS / vLLM Adapter"]
    end

    PROMPT["Prompt Registry\nVersioned, externalized"]
