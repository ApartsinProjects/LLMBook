flowchart TB
    subgraph MOE["<b>Switch Transformer MoE Layer</b>"]
        direction TB

        subgraph INPUT_TOKENS["<b>Input Tokens</b>"]
            direction LR
            T1["<b>Token 1</b>"]
            T2["<b>Token 2</b>"]
            T3["<b>Token 3</b>"]
            T4["<b>Token 4</b>"]
        end

        ATTN["<b>Self-Attention Layer</b><br/><i>Standard multi-head attention</i>"]
        NORM["<b>Layer Norm + Residual</b>"]

        ROUTER["<b>Router Network</b><br/><i>Softmax over experts,<br/>each token picks top-1</i>"]

        subgraph EXPERTS["<b>Expert FFN Pool</b>"]
            direction LR
            E1["<b>Expert 1</b><br/><i>FFN</i>"]
            E2["<b>Expert 2</b><br/><i>FFN</i>"]
            E3["<b>Expert 3</b><br/><i>FFN</i>"]
            EN["<b>Expert N</b><br/><i>FFN</i>"]
        end

        COMBINE["<b>Weighted Combine</b><br/><i>Router score x expert output</i>"]
        NORM2["<b>Layer Norm + Residual</b>"]
        OUTPUT["<b>Output Tokens</b>"]
    end

    T1 --> ATTN
    T2 --> ATTN
    T3 --> ATTN
    T4 --> ATTN
    ATTN --> NORM --> ROUTER

    ROUTER -->|"Token 1, 3"| E1
    ROUTER -->|"Token 2"| E2
    ROUTER -.->|"(unused)"| E3
    ROUTER -->|"Token 4"| EN

    E1 --> COMBINE
    E2 --> COMBINE
    EN --> COMBINE
    COMBINE --> NORM2 --> OUTPUT

    style T1 fill:#1a1a2e,stroke:#0f3460,stroke-width:2px,color:#fff
    style T2 fill:#1a1a2e,stroke:#0f3460,stroke-width:2px,color:#fff
