    style NORM fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style ROUTER fill:#fce4ec,stroke:#c62828,stroke-width:2px,color:#1a1a2e
    style E1 fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style E2 fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
