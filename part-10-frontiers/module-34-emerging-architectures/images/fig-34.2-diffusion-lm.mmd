flowchart LR
    subgraph DLM["<b>Diffusion Language Model (LLaDA)</b>"]
        direction LR

        subgraph PRETRAIN["<b>Pre-training</b><br/><i>Random Masking</i>"]
            direction TB
            PT_IN["The cat sat on [M] [M]"]
            PT_MASK["<b>Random Mask</b><br/><i>Mask ratio ~ U(0,1)</i>"]
            PT_PRED["<b>Predict Masked</b><br/><i>the, mat</i>"]
            PT_IN --> PT_MASK --> PT_PRED
        end

        subgraph SFT["<b>Supervised Fine-Tuning</b><br/><i>Response-Only Masking</i>"]
            direction TB
            SFT_IN["Q: What is 2+2?<br/>A: [M] [M] [M]"]
            SFT_MASK["<b>Mask Response</b><br/><i>Keep prompt visible</i>"]
            SFT_PRED["<b>Predict Response</b><br/><i>The answer is 4</i>"]
            SFT_IN --> SFT_MASK --> SFT_PRED
        end

        subgraph SAMPLE["<b>Sampling (Inference)</b><br/><i>Iterative Unmasking</i>"]
            direction TB
            S1["t=1.0: [M] [M] [M] [M] [M]"]
            S2["t=0.7: The [M] [M] [M] [M]"]
            S3["t=0.3: The cat [M] on [M]"]
            S4["t=0.0: The cat sat on mat"]
            S1 -->|"unmask<br/>highest confidence"| S2
            S2 -->|"unmask"| S3
            S3 -->|"unmask"| S4
        end
    end

    PRETRAIN -->|"trains<br/>base model"| SFT
    SFT -->|"enables"| SAMPLE

    style PT_IN fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style PT_MASK fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style PT_PRED fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style SFT_IN fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style SFT_MASK fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style SFT_PRED fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style S1 fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style S2 fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style S3 fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style S4 fill:#1a1a2e,stroke:#0f3460,stroke-width:2px,color:#fff
    style DLM fill:#fafafa,stroke:#999,stroke-width:1px,color:#1a1a2e
    style PRETRAIN fill:#f0f7ff,stroke:#1565c0,stroke-width:1px,color:#1a1a2e
    style SFT fill:#f0fff0,stroke:#2e7d32,stroke-width:1px,color:#1a1a2e
    style SAMPLE fill:#fffaf0,stroke:#e65100,stroke-width:1px,color:#1a1a2e
