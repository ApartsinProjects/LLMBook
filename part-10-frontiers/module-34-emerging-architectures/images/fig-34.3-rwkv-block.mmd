flowchart TB
    subgraph RWKV["<b>RWKV Block Architecture</b>"]
        direction TB
        IN["<b>Input Token</b><br/><i>x_t</i>"]

        subgraph TM["<b>Time-Mixing Sub-Block</b>"]
            direction TB
            LN1["<b>LayerNorm</b>"]
            subgraph TM_INNER["<b>R, W, K, V Operations</b>"]
                direction LR
                R1["<b>R (Receptance)</b><br/><i>Sigmoid gate</i>"]
                WKV["<b>WKV</b><br/><i>Weighted Key-Value<br/>with decay W</i>"]
            end
            TM_OUT["<b>Output Projection</b>"]
        end

        RES1(["<b>Residual Add</b>"])

        subgraph CM["<b>Channel-Mixing Sub-Block</b>"]
            direction TB
            LN2["<b>LayerNorm</b>"]
            subgraph CM_INNER["<b>R, K Operations</b>"]
                direction LR
                R2["<b>R (Receptance)</b><br/><i>Sigmoid gate</i>"]
                K2["<b>K (Key)</b><br/><i>Squared ReLU</i>"]
            end
            CM_OUT["<b>Value Projection</b>"]
        end

        RES2(["<b>Residual Add</b>"])
        OUT["<b>Output</b><br/><i>x_{t+1}</i>"]
    end

    IN --> LN1
    LN1 --> R1
    LN1 --> WKV
    R1 -->|"gates"| TM_OUT
    WKV -->|"produces"| TM_OUT
    IN --> RES1
    TM_OUT --> RES1

    RES1 --> LN2
    LN2 --> R2
    LN2 --> K2
    R2 -->|"gates"| CM_OUT
    K2 -->|"produces"| CM_OUT
    RES1 --> RES2
    CM_OUT --> RES2
    RES2 --> OUT

    style IN fill:#1a1a2e,stroke:#0f3460,stroke-width:2px,color:#fff
    style OUT fill:#1a1a2e,stroke:#0f3460,stroke-width:2px,color:#fff
    style LN1 fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style LN2 fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style R1 fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style WKV fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style TM_OUT fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style R2 fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style K2 fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px,color:#1a1a2e
    style CM_OUT fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px,color:#1a1a2e
    style RES1 fill:#fce4ec,stroke:#c62828,stroke-width:2px,color:#1a1a2e
    style RES2 fill:#fce4ec,stroke:#c62828,stroke-width:2px,color:#1a1a2e
    style RWKV fill:#fafafa,stroke:#999,stroke-width:1px,color:#1a1a2e
    style TM fill:#f0f7ff,stroke:#1565c0,stroke-width:1px,color:#1a1a2e
    style TM_INNER fill:#f8fbff,stroke:#90caf9,stroke-width:1px,color:#1a1a2e
    style CM fill:#faf0ff,stroke:#6a1b9a,stroke-width:1px,color:#1a1a2e
    style CM_INNER fill:#fdf5ff,stroke:#ce93d8,stroke-width:1px,color:#1a1a2e
