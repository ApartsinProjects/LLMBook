flowchart TB
    subgraph TR["Transformer Block"]
        TI["Token sequence x_1 ... x_T"]
        ATTN["Self-Attention\nO(T squared) compute\nKV cache grows with T"]
        FF1["FFN"]
        TO["Output"]
        TI --> ATTN --> FF1 --> TO
    end

    subgraph SSM["Mamba (Selective SSM) Block"]
        SI["Token sequence x_1 ... x_T"]
        SEL["Input-dependent\nA, B, C, dt"]
        SCAN["Parallel Scan\nO(T) compute\nFixed-size state h_t"]
        FF2["FFN"]
        SO["Output"]
        SI --> SEL --> SCAN --> FF2 --> SO
    end

    NOTE["Trade-off:\nMamba: linear scaling, streaming inference\nTransformer: full content access, mature ecosystem"]

    TR -.-> NOTE
    SSM -.-> NOTE

