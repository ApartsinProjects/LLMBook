flowchart TB
    ROOT["Attention Variants\nfor Long Context"]

    SPARSE["Sparse Attention\nfixed pattern,\nsubset of keys"]
    LINEAR["Linear Attention\nkernel feature map,\nO(T) memory"]
    HIER["Hierarchical / Block\ncompress chunks then attend"]
    RECUR["Recurrent / SSM\nfixed-size state,\nstreaming"]

    SPARSE --> LONGFORMER["Longformer\nsliding + global"]
    SPARSE --> BIGBIRD["BigBird\nrandom + local + global"]

    LINEAR --> PERFORMER["Performer\nFAVOR+ random features"]
    LINEAR --> LINFORMER["Linformer\nlow-rank projection"]

    HIER --> HIERATT["Hierarchical Attention"]
    HIER --> COMP["Compressive Transformer"]

    RECUR --> MAMBA["Mamba\nselective SSM"]
    RECUR --> RWKV["RWKV\nattention-free RNN"]
    RECUR --> HGRN2["HGRN2\nhierarchical gated recurrence"]

    ROOT --> SPARSE
    ROOT --> LINEAR
    ROOT --> HIER
    ROOT --> RECUR

