flowchart TB
    ENV["<b>Environment</b><br/><i>Observation o_t</i>"]

    subgraph V["<b>V: Vision Model (VAE)</b>"]
        direction LR
        ENC["<b>Encoder</b><br/><i>Compress observation</i>"]
        Z["<b>Latent z_t</b><br/><i>Compact representation</i>"]
        ENC --> Z
    end

    subgraph M["<b>M: Memory Model (RNN/MDN)</b>"]
        direction LR
        H_PREV["<b>Hidden h_{t-1}</b>"]
        RNN["<b>RNN Cell</b><br/><i>Predict next state</i>"]
        H_NEXT["<b>Hidden h_t</b>"]
        Z_PRED["<b>Predicted z_{t+1}</b>"]
        H_PREV --> RNN
        RNN --> H_NEXT
        RNN --> Z_PRED
    end

    subgraph C["<b>C: Controller</b>"]
        direction LR
        CONCAT["<b>Concatenate</b><br/><i>[z_t, h_t]</i>"]
        LINEAR["<b>Linear Policy</b><br/><i>Small network</i>"]
        ACTION["<b>Action a_t</b>"]
        CONCAT --> LINEAR --> ACTION
    end

    DREAM["<b>Dream Training</b><br/><i>Controller trains inside<br/>M's imagined futures</i>"]

    ENV -->|"raw pixels"| ENC
    Z -->|"z_t"| RNN
    Z -->|"z_t"| CONCAT
    H_NEXT -->|"h_t"| CONCAT
    ACTION -->|"a_t"| RNN
    ACTION -->|"a_t"| ENV

    Z_PRED -.->|"imagined trajectory"| DREAM
    DREAM -.->|"optimizes"| LINEAR

    style ENV fill:#1a1a2e,stroke:#0f3460,stroke-width:2px,color:#fff
    style ENC fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style Z fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style H_PREV fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style RNN fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style H_NEXT fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style Z_PRED fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style CONCAT fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px,color:#1a1a2e
    style LINEAR fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px,color:#1a1a2e
    style ACTION fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style DREAM fill:#fce4ec,stroke:#c62828,stroke-width:2px,color:#1a1a2e
    style V fill:#f0f7ff,stroke:#1565c0,stroke-width:1px,color:#1a1a2e
    style M fill:#f0fff0,stroke:#2e7d32,stroke-width:1px,color:#1a1a2e
    style C fill:#faf0ff,stroke:#6a1b9a,stroke-width:1px,color:#1a1a2e
