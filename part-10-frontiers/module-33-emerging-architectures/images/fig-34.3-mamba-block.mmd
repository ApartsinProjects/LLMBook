flowchart TB
    subgraph MAMBA["<b>Mamba Block Architecture</b>"]
        direction TB
        IN["<b>Input</b><br/><i>x (sequence tokens)</i>"]

        subgraph BRANCH["<b>Dual Branch Processing</b>"]
            direction LR
            subgraph LEFT["<b>Main Branch</b>"]
                direction TB
                LP1["<b>Linear Projection</b><br/><i>Expand dim</i>"]
                CONV["<b>Conv1D</b><br/><i>Local context</i>"]
                SILU1["<b>SiLU Activation</b>"]
                SSM["<b>Selective SSM</b><br/><i>Selective scan</i>"]
            end
            subgraph RIGHT["<b>Gate Branch</b>"]
                direction TB
                LP2["<b>Linear Projection</b><br/><i>Expand dim</i>"]
                SILU2["<b>SiLU Activation</b>"]
            end
        end

        MULT(["<b>Multiply (Gate)</b>"])
        PROJ_OUT["<b>Output Projection</b><br/><i>Reduce dim</i>"]
        OUT["<b>Output</b><br/><i>y (same shape as x)</i>"]

        subgraph SELECTIVE["<b>Input-Dependent Parameters</b>"]
            direction LR
            B_PROJ["<b>B(x)</b><br/><i>Input matrix</i>"]
            C_PROJ["<b>C(x)</b><br/><i>Output matrix</i>"]
            DELTA["<b>delta(x)</b><br/><i>Step size</i>"]
        end
    end

    IN --> LP1
    IN --> LP2
    LP1 --> CONV --> SILU1 --> SSM
    LP2 --> SILU2
    SSM --> MULT
    SILU2 --> MULT
    MULT --> PROJ_OUT --> OUT

    SILU1 -.->|"projects"| B_PROJ
    SILU1 -.->|"projects"| C_PROJ
    SILU1 -.->|"projects"| DELTA
    B_PROJ -.->|"feeds"| SSM
    C_PROJ -.->|"feeds"| SSM
    DELTA -.->|"feeds"| SSM

    style IN fill:#1a1a2e,stroke:#0f3460,stroke-width:2px,color:#fff
    style OUT fill:#1a1a2e,stroke:#0f3460,stroke-width:2px,color:#fff
    style LP1 fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style CONV fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style SILU1 fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style SSM fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style LP2 fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style SILU2 fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style MULT fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px,color:#1a1a2e
    style PROJ_OUT fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style B_PROJ fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style C_PROJ fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style DELTA fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style MAMBA fill:#fafafa,stroke:#999,stroke-width:1px,color:#1a1a2e
    style BRANCH fill:#f5f5f5,stroke:#ccc,stroke-width:1px,color:#1a1a2e
    style LEFT fill:#f0f7ff,stroke:#1565c0,stroke-width:1px,color:#1a1a2e
    style RIGHT fill:#f0fff0,stroke:#2e7d32,stroke-width:1px,color:#1a1a2e
    style SELECTIVE fill:#fffaf0,stroke:#e65100,stroke-width:1px,color:#1a1a2e
