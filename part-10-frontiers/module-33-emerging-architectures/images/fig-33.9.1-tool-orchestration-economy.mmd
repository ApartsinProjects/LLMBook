flowchart TB
    REQ["User Request"]
    META["Meta-Planner LLM\ndecompose into\ntool-shaped subgoals"]

    subgraph REGISTRY["Tool Registry / Marketplace"]
        T1["Search Tools\nweb, vector DB"]
        T2["Compute Tools\ncode, SQL, Python"]
        T3["External APIs\npaid, rate-limited"]
        T4["Specialist Agents\nsub-agents as tools"]
    end

    ROUTER["Tool Router\ncost x latency x reliability\nbid / select"]
    BUDGET["Budget Tracker\ntokens, dollars, time"]
    CACHE["Result Cache\nmemoize tool calls"]
    EXEC["Executor"]
    SYNTH["Synthesizer\nmerge tool outputs"]
    OUT["Response"]

    REQ --> META --> ROUTER
    ROUTER --> T1
    ROUTER --> T2
    ROUTER --> T3
    ROUTER --> T4
    ROUTER -.-> BUDGET
    ROUTER -.-> CACHE
    T1 --> EXEC
    T2 --> EXEC
    T3 --> EXEC
    T4 --> EXEC
    EXEC --> SYNTH --> OUT

    style REQ fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style META fill:#f3e5f5,stroke:#722f8a,stroke-width:3px,color:#1a1a2e
