flowchart TB
    subgraph EXAMPLES["<b>Domain Examples</b>"]
        direction LR
        EX1["<b>Proteins:</b> MKTL... per-residue tokens"]
        EX2["<b>Code:</b> def, return, indent tokens"]
        EX3["<b>Chemistry:</b> C, (=O), [NH] SMILES tokens"]
        EX4["<b>DNA:</b> ATG, GCC k-mer tokens"]
    end

    RAW["<b>Raw Domain Text</b><br/><i>Proteins, code,<br/>molecules, DNA, etc.</i>"]

    PRE["<b>Pre-tokenizer</b><br/><i>Domain-specific rules<br/>(e.g., split on codons,<br/>amino acids, SMILES bonds)</i>"]

    TRAIN["<b>BPE / Unigram Training</b><br/><i>Learn merges on domain corpus</i>"]

    VOCAB["<b>Domain Vocabulary</b><br/><i>Domain-specific subword units</i>"]

    MERGE["<b>Vocabulary Merging</b><br/><i>Combine with base tokenizer vocab</i>"]

    FINAL["<b>Final Tokenizer</b><br/><i>Handles both natural language<br/>and domain sequences</i>"]

    EXAMPLES -.->|"inform rules"| PRE
    RAW --> PRE -->|"domain units"| TRAIN -->|"learned merges"| VOCAB --> MERGE --> FINAL

    style RAW fill:#1a1a2e,stroke:#0f3460,stroke-width:2px,color:#fff
    style PRE fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style TRAIN fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style VOCAB fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style MERGE fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px,color:#1a1a2e
    style FINAL fill:#1a1a2e,stroke:#0f3460,stroke-width:2px,color:#fff
    style EX1 fill:#e3f2fd,stroke:#1565c0,stroke-width:1px,color:#1a1a2e
    style EX2 fill:#e8f5e9,stroke:#2e7d32,stroke-width:1px,color:#1a1a2e
    style EX3 fill:#fff3e0,stroke:#e65100,stroke-width:1px,color:#1a1a2e
    style EX4 fill:#f3e5f5,stroke:#6a1b9a,stroke-width:1px,color:#1a1a2e
    style EXAMPLES fill:#f5f5f5,stroke:#ccc,stroke-width:1px,color:#1a1a2e
