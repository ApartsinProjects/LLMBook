flowchart LR
    OBS["Observation o_t\npixels, sensors"]
    ENC["Encoder\nimage to latent z_t"]

    subgraph CORE["World Model Core"]
        DYN["Dynamics Model\np(z_{t+1} | z_t, a_t)"]
        REW["Reward Predictor"]
        DEC["Decoder\nz_t to reconstruction"]
    end

    POL["Policy / Planner\nimagine trajectories\nin latent space"]
    ACT["Action a_t"]
    ENV["Environment"]

    OBS --> ENC --> DYN
    DYN --> REW
    DYN --> DEC
    DYN -->|"imagined rollouts"| POL
    POL --> ACT --> ENV
    ENV -->|"o_{t+1}, r_t"| OBS

    style OBS fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style ENC fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style DYN fill:#f3e5f5,stroke:#722f8a,stroke-width:3px,color:#1a1a2e
    style REW fill:#f3e5f5,stroke:#722f8a,stroke-width:2px,color:#1a1a2e
    style DEC fill:#f3e5f5,stroke:#722f8a,stroke-width:2px,color:#1a1a2e
    style POL fill:#fce4ec,stroke:#c62828,stroke-width:2px,color:#1a1a2e
    style ACT fill:#e8f5e9,stroke:#1f7a3a,stroke-width:2px,color:#1a1a2e
