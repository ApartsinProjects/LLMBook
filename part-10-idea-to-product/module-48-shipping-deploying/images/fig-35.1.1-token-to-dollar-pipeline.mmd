flowchart LR
    USER["User Request"]
    APP["Application Layer"]
    PROMPT["Prompt Assembly\nSystem + Context + Query"]
    TOK["Tokenizer\n~4 chars per token"]
    API["LLM Provider API"]
    OUT["Output Tokens\nGenerated"]
    BILL["Billing\nInput x rate_in\n+ Output x rate_out"]
    INV["Monthly Invoice"]

    USER --> APP --> PROMPT --> TOK --> API
    API --> OUT --> BILL --> INV

    PROMPT -.->|"long context"| TOK
    OUT -.->|"streaming"| APP

