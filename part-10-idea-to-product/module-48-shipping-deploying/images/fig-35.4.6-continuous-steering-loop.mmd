flowchart LR
    PROD["Production Traffic"]
    LOG["Sample and Log\nRequests, outputs, costs"]
    DRIFT{"Drift Detected?"}
    EVAL["Run Eval Suite\nGolden set + LLM judge"]
    DASH["Dashboard\nQuality, cost, latency"]
    DEC{"Within SLOs?"}
    OPT["Re-optimize\nPrompt, model, cache"]
    AB["A/B Test Change"]
    SHIP["Ship to Production"]

    PROD --> LOG --> DRIFT
    DRIFT -->|"yes"| EVAL
    DRIFT -->|"no"| DASH
    EVAL --> DASH --> DEC
    DEC -->|"yes"| PROD
    DEC -->|"no"| OPT --> AB --> SHIP --> PROD

    style PROD fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style LOG fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style DRIFT fill:#fff,stroke:#555,stroke-width:1px,color:#1a1a2e
    style EVAL fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style DASH fill:#f3e5f5,stroke:#722f8a,stroke-width:2px,color:#1a1a2e
    style DEC fill:#fff,stroke:#555,stroke-width:1px,color:#1a1a2e
    style OPT fill:#fce4ec,stroke:#c62828,stroke-width:2px,color:#1a1a2e
    style AB fill:#fce4ec,stroke:#c62828,stroke-width:2px,color:#1a1a2e
    style SHIP fill:#e8f5e9,stroke:#1f7a3a,stroke-width:2px,color:#1a1a2e
