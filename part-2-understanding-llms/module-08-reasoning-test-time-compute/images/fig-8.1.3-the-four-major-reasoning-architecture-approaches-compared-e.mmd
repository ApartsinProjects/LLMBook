flowchart TD
    subgraph ARCH["Four Reasoning Architectures"]
        direction TB
        COT["**1. Extended CoT**\nVisible reasoning trace\nNo arch change"]
        HIDDEN["**2. Hidden Thinking**\nInternal tokens (o-series)\nBilled but not shown"]
        VERIFY["**3. Verifier-Guided**\nORM/PRM scoring\nBest-of-N selection"]
        SEARCH["**4. Tree Search**\nMCTS over reasoning\nBranch and backtrack"]
        COT --> HIDDEN --> VERIFY --> SEARCH
    end
    style COT fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style HIDDEN fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style VERIFY fill:#fff3e0,stroke:#e65100,stroke-width:2px
    style SEARCH fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
