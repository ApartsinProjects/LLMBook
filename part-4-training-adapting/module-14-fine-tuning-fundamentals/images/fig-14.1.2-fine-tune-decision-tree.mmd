flowchart TB
    START["Want better task performance"]
    Q1{"Acceptable<br/>with zero-shot<br/>prompting?"}
    Q2{"Acceptable<br/>with few-shot<br/>or RAG?"}
    Q3{"&gt;500 labelled<br/>task examples<br/>available?"}
    Q4{"Latency or<br/>cost critical?"}
    Q5{"&gt;10k examples +<br/>&gt;$50k compute +<br/>fundamentally new<br/>domain?"}

    PROMPT["Use prompting<br/><i>cheapest, fastest iteration</i>"]
    FEWSHOT["Add few-shot or RAG<br/><i>still cheap, no training</i>"]
    PEFT["PEFT (LoRA / adapters)<br/><i>small model edits, ~1%<br/>params trained</i>"]
    FULL["Full fine-tune<br/><i>best quality, biggest cost</i>"]
    SCRATCH["Train from scratch<br/><i>only for new domain or<br/>research, rarely justified</i>"]

    START --> Q1
    Q1 -->|"Yes"| PROMPT
    Q1 -->|"No"| Q2
    Q2 -->|"Yes"| FEWSHOT
    Q2 -->|"No"| Q3
    Q3 -->|"No"| FEWSHOT
    Q3 -->|"Yes"| Q4
    Q4 -->|"No"| FULL
    Q4 -->|"Yes"| PEFT
    PEFT --> Q5
    FULL --> Q5
    Q5 -->|"No"| DONE["Ship it"]
    Q5 -->|"Yes"| SCRATCH

