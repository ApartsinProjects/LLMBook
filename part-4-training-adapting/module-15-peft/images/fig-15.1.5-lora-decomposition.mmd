flowchart TB
    INPUT["<b>x</b><br/>(input, d_in)"]
    FROZEN["<b>W</b><br/>frozen pretrained<br/>d_in × d_out<br/>(e.g. 4096 × 4096)"]
    WA["<b>A</b><br/>trainable, d_in × r<br/>(e.g. 4096 × 8)"]
    WB["<b>B</b><br/>trainable, r × d_out<br/>(e.g. 8 × 4096)"]
    PLUS(("<b>+</b>"))
    OUT["<b>h</b><br/>(output, d_out)"]

    INPUT --> FROZEN
    INPUT --> WA
    WA -->|"rank r (e.g. 8)"| WB
    FROZEN --> PLUS
    WB --> PLUS
    PLUS --> OUT

