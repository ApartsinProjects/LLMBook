flowchart TB
    SEED["<b>Seed instruction</b><br/><i>e.g. 'Solve 2 + 2'</i>"]

    subgraph IND["IN-DEPTH evolution (raise complexity of the SAME task)"]
        direction TB
        ADD["<b>Add Constraints</b><br/>'Solve 2 + 2 in 30 seconds<br/>and explain your reasoning.'"]
        DEEP["<b>Deepening</b><br/>'Solve 2 + 2, then prove<br/>the identity element of<br/>addition over the integers.'"]
        CONC["<b>Concretizing</b><br/>'Mary has 2 apples. Tom<br/>gives her 2 more. How<br/>many apples now?'"]
        STEP["<b>Reasoning Steps</b><br/>'List intermediate steps<br/>before stating the answer.'"]
        INPUT["<b>Complicate Input</b><br/>'Solve 2 + 2 given that<br/>operands are in base-7.'"]
    end

    subgraph BRD["IN-BREADTH evolution (generate a DIFFERENT task at same complexity)"]
        direction TB
        TOPIC["<b>New Topic</b><br/>'Solve 3 × 5'<br/>(arithmetic, related)"]
        DOMAIN["<b>New Domain</b><br/>'Conjugate the French<br/>verb parler.'<br/>(unrelated topic)"]
    end

    SEED --> ADD
    SEED --> DEEP
    SEED --> CONC
    SEED --> STEP
    SEED --> INPUT
    SEED --> TOPIC
    SEED --> DOMAIN

    POOL["<b>Generation pool</b><br/>(deduped + quality-filtered)"]

    ADD --> POOL
    DEEP --> POOL
    CONC --> POOL
    STEP --> POOL
    INPUT --> POOL
    TOPIC --> POOL
    DOMAIN --> POOL

    POOL -.->|"feed best back as new seeds"| SEED

    style SEED fill:#e3f2fd,stroke:#1565c0,stroke-width:2.5px,color:#1a1a2e
    style POOL fill:#e8f5e9,stroke:#2e7d32,stroke-width:2.5px,color:#1a1a2e
    style IND fill:#fff3e0,stroke:#e65100,stroke-width:1.5px
    style BRD fill:#f3e5f5,stroke:#6a1b9a,stroke-width:1.5px
