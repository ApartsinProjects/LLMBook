flowchart TB
    PHOTOS["Input Photographs\n20 to 100 views"]
    SFM["Structure-from-Motion\nCOLMAP point cloud + poses"]
    INIT["Initialize Gaussians\nposition, covariance,\nopacity, SH coefficients"]

    subgraph LOOP["Differentiable Optimization Loop"]
        RAST["Tile-Based Rasterizer\nProject and blend Gaussians"]
        LOSS["L1 + SSIM Loss\nvs ground-truth photo"]
        GRAD["Backprop Gradients\nupdate all parameters"]
        DENS["Adaptive Density Control\nsplit, clone, prune"]
    end

    OUT["Trained Scene\n1 to 5M Gaussians\nReal-time rendering"]

    PHOTOS --> SFM --> INIT --> RAST --> LOSS --> GRAD --> DENS
    DENS -->|"every 100 iters"| RAST
    DENS --> OUT

    style PHOTOS fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style SFM fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style INIT fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style RAST fill:#f3e5f5,stroke:#722f8a,stroke-width:2px,color:#1a1a2e
    style LOSS fill:#fce4ec,stroke:#c62828,stroke-width:2px,color:#1a1a2e
    style GRAD fill:#fce4ec,stroke:#c62828,stroke-width:2px,color:#1a1a2e
    style DENS fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style OUT fill:#e8f5e9,stroke:#1f7a3a,stroke-width:2px,color:#1a1a2e
