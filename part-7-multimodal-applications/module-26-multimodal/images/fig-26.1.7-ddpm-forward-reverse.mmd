flowchart LR
    subgraph FWD["FORWARD: progressively add Gaussian noise"]
        direction LR
        X0["x_0<br/><i>clean sample</i>"] -->|"q(x_t | x_{t-1})"| X1["x_1<br/><i>slightly noisy</i>"]
        X1 -->|"+ noise"| X2["..."]
        X2 -->|"+ noise"| XT["x_T<br/><i>pure Gaussian noise</i>"]
    end

    subgraph REV["REVERSE: learn to denoise step by step"]
        direction RL
        Y0["x_0<br/><i>reconstructed sample</i>"]
        Y1["x_1"]
        Y2["..."]
        YT["x_T<br/><i>sampled from N(0, I)</i>"]
        YT -->|"p_theta(x_{t-1} | x_t)"| Y2
        Y2 -->|"denoise"| Y1
        Y1 -->|"denoise"| Y0
    end

    XT -.->|"start denoising from noise"| YT

    style X0 fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style X1 fill:#bbdefb,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style X2 fill:#90caf9,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style XT fill:#1565c0,stroke:#0d47a1,stroke-width:2px,color:#ffffff
    style YT fill:#1565c0,stroke:#0d47a1,stroke-width:2px,color:#ffffff
    style Y2 fill:#90caf9,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style Y1 fill:#bbdefb,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style Y0 fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style FWD fill:#fafafa,stroke:#9e9e9e,stroke-width:1px
    style REV fill:#fafafa,stroke:#9e9e9e,stroke-width:1px
