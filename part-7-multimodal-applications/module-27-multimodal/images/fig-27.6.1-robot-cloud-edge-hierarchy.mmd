flowchart TB
    GOAL["High-Level Goal\n'clean the kitchen'"]

    subgraph CLOUD["Cloud (high-latency, high-capability)"]
        PLAN["Task Planner\nLarge VLM\nDecomposes into subgoals"]
    end

    subgraph EDGE["Edge / Onboard (low-latency)"]
        SKILL["Skill Selector\nSmall LM"]
        POL["Action Policy\nVLA model"]
        SAFE["Safety Monitor\nConstraint checker"]
    end

    HW["Robot Hardware\nMotors, sensors"]

    GOAL --> PLAN
    PLAN -->|"subgoal stream"| SKILL
    SKILL --> POL
    POL --> SAFE
    SAFE -->|"approved actions"| HW
    HW -.->|"observations"| POL
    HW -.->|"failures, replan"| PLAN

    style GOAL fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style PLAN fill:#f3e5f5,stroke:#722f8a,stroke-width:2px,color:#1a1a2e
    style SKILL fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style POL fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style SAFE fill:#fce4ec,stroke:#c62828,stroke-width:2px,color:#1a1a2e
    style HW fill:#e8f5e9,stroke:#1f7a3a,stroke-width:2px,color:#1a1a2e
