flowchart TB
    AGENT["Agent Under Test"]

    subgraph OFFLINE["Offline Evaluation"]
        UNIT["Unit Tests\nindividual tools, prompts"]
        SCEN["Scenario Suite\ncurated tasks + golden traces"]
        REPLAY["Trace Replay\nproduction logs as fixtures"]
    end

    subgraph ONLINE["Online Evaluation"]
        SHADOW["Shadow Traffic\nrun new agent silently"]
        AB["A/B Experiment\nsplit live users"]
        FEED["User Feedback\nthumbs, edits, escalations"]
    end

    METRICS["Metric Aggregator\ntask success, cost,\nsafety violations, latency"]
    GATE{"Promotion Gate\npasses thresholds?"}
    PROD["Promote to Production"]
    BACK["Block, iterate"]

    AGENT --> UNIT
    AGENT --> SCEN
    AGENT --> REPLAY
    AGENT --> SHADOW
    AGENT --> AB
    AGENT --> FEED

    UNIT --> METRICS
    SCEN --> METRICS
    REPLAY --> METRICS
    SHADOW --> METRICS
    AB --> METRICS
    FEED --> METRICS

    METRICS --> GATE
    GATE -->|"yes"| PROD
    GATE -->|"no"| BACK

    style AGENT fill:#f3e5f5,stroke:#722f8a,stroke-width:3px,color:#1a1a2e
    style UNIT fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style SCEN fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style REPLAY fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style SHADOW fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style AB fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style FEED fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style METRICS fill:#fce4ec,stroke:#c62828,stroke-width:2px,color:#1a1a2e
    style GATE fill:#fff,stroke:#555,stroke-width:1px,color:#1a1a2e
    style PROD fill:#e8f5e9,stroke:#1f7a3a,stroke-width:2px,color:#1a1a2e
