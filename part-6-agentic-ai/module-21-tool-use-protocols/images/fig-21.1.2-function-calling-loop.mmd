flowchart TB
    USER["<b>User</b><br/><i>'What's the weather in Paris?'</i>"]
    APP["<b>Application</b><br/><i>your code</i>"]
    LLM["<b>LLM</b><br/><i>provider API</i>"]
    PARSE["<b>Parser + Validator</b><br/><i>JSON schema check,<br/>argument types</i>"]
    TOOL["<b>Tool function</b><br/><i>e.g. get_weather(city)</i>"]
    EXT["<b>External resource</b><br/><i>HTTP API, DB, file</i>"]
    RESULT["<b>Tool result</b><br/><i>'22°C, sunny'</i>"]
    FINAL["<b>Final reply</b><br/><i>'It's 22°C and sunny in Paris.'</i>"]

    USER -->|"1. user message"| APP
    APP -->|"2. prompt + tools schema"| LLM
    LLM -->|"3. tool_call: {name, args}"| PARSE
    PARSE -->|"4. validated args"| APP
    APP -->|"5. invoke"| TOOL
    TOOL -->|"6. fetch"| EXT
    EXT -->|"7. raw data"| TOOL
    TOOL -->|"8. typed return"| RESULT
    RESULT -->|"9. tool_result message"| APP
    APP -->|"10. updated context"| LLM
    LLM -->|"11. assistant text"| FINAL
    FINAL --> USER

    LLM -.->|"may emit another tool_call instead"| PARSE

    style USER fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style APP fill:#fff3e0,stroke:#e65100,stroke-width:2.5px,color:#1a1a2e
    style LLM fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2.5px,color:#1a1a2e
    style PARSE fill:#fff8e1,stroke:#f9a825,stroke-width:2px,color:#1a1a2e
    style TOOL fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style EXT fill:#fce4ec,stroke:#c62828,stroke-width:2px,color:#1a1a2e
    style RESULT fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style FINAL fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
