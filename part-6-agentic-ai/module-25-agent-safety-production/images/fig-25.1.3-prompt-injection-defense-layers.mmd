flowchart TB
    USER["User / External Input\nuntrusted text, tool output, web page"]

    L1["Layer 1: Input Sanitization\nstrip control tokens, limit length"]
    L2["Layer 2: Prompt Hardening\nsystem instructions, delimiters,\nspotlighting"]
    L3["Layer 3: Privilege Separation\ntrusted vs untrusted context\nstructured prompts"]
    L4["Layer 4: Output Filtering\nclassifier, regex, allow-list"]
    L5["Layer 5: Action Approval\nhuman-in-the-loop for\nhigh-impact tools"]

    LLM(("Agent LLM"))
    TOOL["Tool Execution"]

    USER --> L1 --> L2 --> LLM
    L3 -.->|"context labels"| LLM
    LLM --> L4 --> L5 --> TOOL

    L4 -.->|"flag"| ALERT["Audit and Alert"]
    L5 -.->|"deny"| ALERT

