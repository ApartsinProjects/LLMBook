flowchart TB
    ERR["Error Detected"]
    TRANS{"Transient?\nTimeout, rate limit"}

    ERR --> TRANS

    TRANS -->|"Yes"| RETRY["Retry with\nExponential Backoff"]
    TRANS -->|"No"| PERM{"Alternative\nAvailable?"}

    RETRY --> SUCC1{"Succeeded?"}
    SUCC1 -->|"Yes"| DONE["Continue"]
    SUCC1 -->|"max retries"| FALL

    PERM -->|"Yes"| FALL["Fallback Chain\nSecondary provider"]
    PERM -->|"No"| CB["Circuit Breaker\nStop calling failed component"]

    FALL --> SUCC2{"Succeeded?"}
    SUCC2 -->|"Yes"| DONE
    SUCC2 -->|"No"| CB

    CB --> GRACE["Graceful Degradation\nReturn partial result"]

    style ERR fill:#fce4ec,stroke:#c62828,stroke-width:2px,color:#1a1a2e
    style TRANS fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style RETRY fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style FALL fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px,color:#1a1a2e
    style CB fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style GRACE fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style DONE fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style SUCC1 fill:#fff,stroke:#555,stroke-width:1px,color:#1a1a2e
    style SUCC2 fill:#fff,stroke:#555,stroke-width:1px,color:#1a1a2e
    style PERM fill:#fff,stroke:#555,stroke-width:1px,color:#1a1a2e
