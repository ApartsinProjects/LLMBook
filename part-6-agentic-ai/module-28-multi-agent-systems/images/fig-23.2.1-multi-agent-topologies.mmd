flowchart TB
    subgraph HUB["A. Hub-and-Spoke (supervisor)"]
        direction TB
        H_SUP["<b>Supervisor</b><br/>orchestrates"]
        H_A1["Worker 1"]
        H_A2["Worker 2"]
        H_A3["Worker 3"]
        H_SUP --> H_A1
        H_SUP --> H_A2
        H_SUP --> H_A3
        H_A1 --> H_SUP
        H_A2 --> H_SUP
        H_A3 --> H_SUP
    end

    subgraph PIPE["B. Pipeline (sequential handoff)"]
        direction LR
        P_IN["Input"]
        P_A1["Stage 1"]
        P_A2["Stage 2"]
        P_A3["Stage 3"]
        P_OUT["Output"]
        P_IN --> P_A1 --> P_A2 --> P_A3 --> P_OUT
    end

    subgraph MESH["C. Fully Connected (mesh)"]
        direction TB
        M_A1["Agent 1"]
        M_A2["Agent 2"]
        M_A3["Agent 3"]
        M_A4["Agent 4"]
        M_A1 <--> M_A2
        M_A1 <--> M_A3
        M_A1 <--> M_A4
        M_A2 <--> M_A3
        M_A2 <--> M_A4
        M_A3 <--> M_A4
    end

    style H_SUP fill:#fff3e0,stroke:#e65100,stroke-width:2.5px,color:#1a1a2e
    style H_A1 fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style H_A2 fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style H_A3 fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style P_IN fill:#fff,stroke:#555,stroke-width:1.5px,color:#1a1a2e
    style P_A1 fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style P_A2 fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style P_A3 fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style P_OUT fill:#fff,stroke:#555,stroke-width:1.5px,color:#1a1a2e
    style M_A1 fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px,color:#1a1a2e
    style M_A2 fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px,color:#1a1a2e
    style M_A3 fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px,color:#1a1a2e
    style M_A4 fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px,color:#1a1a2e
    style HUB fill:#fafafa,stroke:#888,stroke-width:1.5px
    style PIPE fill:#fafafa,stroke:#888,stroke-width:1.5px
    style MESH fill:#fafafa,stroke:#888,stroke-width:1.5px
