flowchart TB
    AGENT["Agent Runtime\nplanner + tools + memory"]

    subgraph INSTR["Instrumentation Layer"]
        TR["Traces\nspans per LLM call,\ntool, sub-agent"]
        ME["Metrics\ntokens, latency, cost,\nsuccess rate"]
        LO["Logs\nprompts, completions,\nerrors"]
    end

    subgraph STORE["Storage and Indexing"]
        OTEL["OpenTelemetry\nCollector"]
        TS["Time-Series DB\nPrometheus"]
        TRACE["Trace Backend\nJaeger / Langfuse"]
    end

    subgraph CONSUME["Consumers"]
        DASH["Dashboards\nGrafana"]
        ALRT["Alerts\nPagerDuty"]
        REPLAY["Trace Replay\nDebug + eval"]
    end

    AGENT --> TR
    AGENT --> ME
    AGENT --> LO
    TR --> OTEL
    ME --> OTEL
    LO --> OTEL
    OTEL --> TS
    OTEL --> TRACE
    TS --> DASH
    TS --> ALRT
    TRACE --> REPLAY

    style AGENT fill:#f3e5f5,stroke:#722f8a,stroke-width:3px,color:#1a1a2e
    style TR fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style ME fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style LO fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style OTEL fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style TS fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style TRACE fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style DASH fill:#e8f5e9,stroke:#1f7a3a,stroke-width:2px,color:#1a1a2e
    style ALRT fill:#fce4ec,stroke:#c62828,stroke-width:2px,color:#1a1a2e
    style REPLAY fill:#e8f5e9,stroke:#1f7a3a,stroke-width:2px,color:#1a1a2e
