flowchart TB
    subgraph DEFINE["<b>1. Define</b>"]
        SIG["<b>Signature</b><br/><i>Input/output contract<br/>question, context &#8594; answer</i>"]
        MOD["<b>Module</b><br/><i>Reasoning pattern<br/>ChainOfThought, ReAct</i>"]
        MET["<b>Metric</b><br/><i>Accuracy, F1,<br/>user satisfaction</i>"]
    end

    subgraph OPTIMIZE["<b>2. Optimize</b>"]
        direction TB
        TRAIN["<b>Training Examples</b><br/><i>Input/expected pairs</i>"]
        OPT["<b>Optimizer</b><br/><i>BootstrapFewShot,<br/>MIPROv2, BayesianSignatureOptimizer</i>"]
        EVAL["<b>Evaluate on<br/>dev set</b>"]
        REFINE["<b>Refine instructions<br/>+ demonstrations</b>"]
        TRAIN --> OPT --> EVAL --> REFINE
        REFINE -->|"iterate"| OPT
    end

    subgraph COMPILE["<b>3. Compile</b>"]
        PROMPT["<b>Optimized Prompt</b><br/><i>Instructions + few-shot<br/>examples + format</i>"]
    end

    DEFINE --> OPTIMIZE --> COMPILE

