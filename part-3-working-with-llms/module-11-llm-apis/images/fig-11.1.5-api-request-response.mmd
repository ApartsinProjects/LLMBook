flowchart LR
    subgraph CLIENT ["<b>Client</b>"]
        direction TB
        C1["model: <i>gpt-4o</i>"]
        C2["messages: <i>[...]</i>"]
        C3["temperature: <i>0.7</i>"]
        C4["max_tokens: <i>200</i>"]
        C5["stream: <i>false</i>"]
        C1 ~~~ C2 ~~~ C3 ~~~ C4 ~~~ C5
    end

    subgraph PROVIDER ["<b>LLM Provider</b>"]
        direction TB
        P1["1. Validate + authenticate"]
        P2["2. Tokenize input"]
        P3["3. Run model inference"]
        P4["4. Decode tokens to text"]
        P5["5. Return JSON response"]
        P1 --> P2 --> P3 --> P4 --> P5
    end

    subgraph RESPONSE ["<b>Response</b>"]
        direction TB
        R1["id: <i>chatcmpl-...</i>"]
        R2["choices: <i>[{...}]</i>"]
        R3["message.content"]
        R4["finish_reason"]
        R5["usage: <i>{tokens}</i>"]
        R1 ~~~ R2 ~~~ R3 ~~~ R4 ~~~ R5
    end

    CLIENT -->|"HTTP POST<br/>JSON body"| PROVIDER
    PROVIDER -->|"JSON<br/>response"| RESPONSE

    style CLIENT fill:#f0f0f5,stroke:#1a1a2e,stroke-width:2px,color:#1a1a2e
    style PROVIDER fill:#1a1a2e,stroke:#0f3460,stroke-width:2px,color:#fff
    style RESPONSE fill:#f0f5f0,stroke:#27ae60,stroke-width:2px,color:#1a1a2e

    style C1 fill:#e8f4fd,stroke:#3498db,color:#2980b9
    style C2 fill:#e8f4fd,stroke:#3498db,color:#2980b9
    style C3 fill:#e8f4fd,stroke:#3498db,color:#2980b9
    style C4 fill:#e8f4fd,stroke:#3498db,color:#2980b9
    style C5 fill:#e8f4fd,stroke:#3498db,color:#2980b9

    style P1 fill:#2d2d4e,stroke:#444,color:#cdd6f4
    style P2 fill:#2d2d4e,stroke:#444,color:#cdd6f4
    style P3 fill:#2d2d4e,stroke:#444,color:#cdd6f4
    style P4 fill:#2d2d4e,stroke:#444,color:#cdd6f4
    style P5 fill:#2d2d4e,stroke:#444,color:#cdd6f4

    style R1 fill:#e8f5e9,stroke:#27ae60,color:#27ae60
    style R2 fill:#e8f5e9,stroke:#27ae60,color:#27ae60
    style R3 fill:#e8f5e9,stroke:#27ae60,color:#27ae60
