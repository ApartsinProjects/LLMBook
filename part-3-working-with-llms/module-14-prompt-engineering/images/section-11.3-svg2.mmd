flowchart TB
    subgraph PIPELINE["<b>Model Chaining Pipeline</b>"]
        direction TB
        N0["<b>Stage 1: Extract</b><br/><i>Parse raw input into structured entities</i><br/>Model: gpt-4o-mini"]
        N2["<b>Stage 2: Analyze</b><br/><i>Reason about entities and relationships</i><br/>Model: gpt-4o"]
        N4["<b>Stage 3: Validate</b><br/><i>Check constraints and consistency</i><br/>Model: gpt-4o-mini"]
        N6["<b>Stage 4: Format</b><br/><i>Produce final structured output</i><br/>Model: gpt-4o-mini"]
        N0 -->|"Entities (JSON)"| N2
        N2 -->|"Analysis + flags"| N4
        N4 -->|"Validated result"| N6
    end

