flowchart TD
    subgraph SOURCES["**Production Sources**"]
        direction TB
        L1["**Chat Logs**\nUser + assistant turns"]
        L2["**Tool Traces**\nCalls + responses"]
        L3["**Feedback**\nThumbs up/down"]
    end

    subgraph EXTRACT["**1. Extraction**"]
        E1["Parse JSONL logs\nExtract conversations\nLink feedback signals"]
    end

    subgraph NORMALIZE["**2. Normalization**"]
        N1["Deduplicate turns\nStandardize timestamps\nResolve user IDs"]
    end

    subgraph FILTER["**3. Filtering**"]
        F1["PII redaction\nQuality scoring\nToxicity removal\nLength bounds"]
    end

    subgraph FORMAT["**4. Formatting**"]
        direction TB
        O1["**SFT Dataset**\ninstruction/response"]
        O2["**DPO Dataset**\nchosen/rejected pairs"]
        O3["**Tool-Use Dataset**\ncall/response schemas"]
        O4["**Eval Dataset**\nquery/expected pairs"]
    end

    SOURCES --> EXTRACT --> NORMALIZE --> FILTER --> FORMAT

