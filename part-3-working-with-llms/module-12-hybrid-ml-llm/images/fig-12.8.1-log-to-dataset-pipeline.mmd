flowchart LR
    subgraph SOURCES["<b>Production Sources</b>"]
        direction TB
        L1["<b>Chat Logs</b><br/><i>User + assistant turns</i>"]
        L2["<b>Tool Traces</b><br/><i>Calls + responses</i>"]
        L3["<b>Feedback</b><br/><i>Thumbs up/down</i>"]
    end

    subgraph EXTRACT["<b>1. Extraction</b>"]
        E1["Parse JSONL logs<br/>Extract conversations<br/>Link feedback signals"]
    end

    subgraph NORMALIZE["<b>2. Normalization</b>"]
        N1["Deduplicate turns<br/>Standardize timestamps<br/>Resolve user IDs"]
    end

    subgraph FILTER["<b>3. Filtering</b>"]
        F1["PII redaction<br/>Quality scoring<br/>Toxicity removal<br/>Length bounds"]
    end

    subgraph FORMAT["<b>4. Formatting</b>"]
        direction TB
        O1["<b>SFT Dataset</b><br/><i>instruction/response</i>"]
        O2["<b>DPO Dataset</b><br/><i>chosen/rejected pairs</i>"]
        O3["<b>Tool-Use Dataset</b><br/><i>call/response schemas</i>"]
        O4["<b>Eval Dataset</b><br/><i>query/expected pairs</i>"]
    end

    SOURCES --> EXTRACT --> NORMALIZE --> FILTER --> FORMAT

