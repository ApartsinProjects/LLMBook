flowchart LR
    subgraph L1 ["<b>Level 1: Prompt-Based</b>"]
        direction TB
        L1A["'Return your answer as JSON'"]
        L1B["Reliability: ~85%"]
        L1P1["+ Simple to implement"]
        L1P2["+ Works with any model"]
        L1C1["- May include extra text"]
        L1C2["- No schema guarantee"]
        L1A ~~~ L1B ~~~ L1P1 ~~~ L1P2 ~~~ L1C1 ~~~ L1C2
    end

    subgraph L2 ["<b>Level 2: JSON Mode</b>"]
        direction TB
        L2A["response_format: json_object"]
        L2B["Reliability: ~98%"]
        L2P1["+ Always valid JSON"]
        L2P2["+ API-level guarantee"]
        L2C1["- Schema not enforced"]
        L2C2["- Keys may vary"]
        L2A ~~~ L2B ~~~ L2P1 ~~~ L2P2 ~~~ L2C1 ~~~ L2C2
    end

    subgraph L3 ["<b>Level 3: Schema-Constrained</b>"]
        direction TB
        L3A["json_schema with strict: true"]
        L3B["Reliability: ~100%"]
        L3P1["+ Exact schema match"]
        L3P2["+ Type-safe fields"]
        L3P3["+ Enum enforcement"]
        L3C1["- Provider-specific"]
        L3A ~~~ L3B ~~~ L3P1 ~~~ L3P2 ~~~ L3P3 ~~~ L3C1
    end

    L1 -->|"more reliable"| L2
    L2 -->|"more reliable"| L3

