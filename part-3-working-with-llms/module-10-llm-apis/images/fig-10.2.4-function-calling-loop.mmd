flowchart TB
    S1["<b>Step 1: User Query</b><br/><i>'What is the weather in Paris?'</i>"]
    S2["<b>Step 2: Model Decides</b><br/><i>finish_reason: tool_calls</i>"]
    S3["<b>Step 3: Tool Call JSON</b><br/>name: get_weather<br/>arguments: {city: Paris}"]
    S4["<b>Step 4: Your Code Executes</b><br/>result = get_weather('Paris')<br/>= '22C, sunny'"]
    S5["<b>Step 5: Model generates final response</b><br/><i>using tool result</i>"]

    KEY["<b>Key Principle</b><br/>The model never executes<br/>functions directly."]

    S1 -->|"send to model"| S2
    S2 -->|"model returns"| S3
    S3 -->|"your code runs"| S4
    S4 -->|"result sent back"| S5

