{
  "theme": "base",
  "themeVariables": {
    "primaryColor": "#e8f4fd",
    "primaryTextColor": "#1a1a2e",
    "primaryBorderColor": "#3498db",
    "lineColor": "#555",
    "secondaryColor": "#f0f7ee",
    "tertiaryColor": "#fef9e7",
    "fontFamily": "Segoe UI, system-ui, sans-serif",
    "fontSize": "14px",
    "nodeTextColor": "#1a1a2e"
  },
  "flowchart": {
    "useMaxWidth": false,
    "htmlLabels": true,
    "curve": "basis",
    "defaultRenderer": "elk"
  },
  "elk": {
    "mergeEdges": true,
    "nodePlacementStrategy": "NETWORK_SIMPLEX"
  }
}
