flowchart LR
    subgraph NAIVE["Naive RAG"]
        direction TB
        N1["Index\nChunk and embed docs"]
        N2["Retrieve\nTop-k similarity"]
        N3["Generate\nLLM with context"]
        N1 --> N2 --> N3
    end

    subgraph ADVANCED["Advanced RAG"]
        direction TB
        A0["Pre-Retrieval\nQuery rewriting, HyDE"]
        A1["Index\nChunk, embed, metadata"]
        A2["Retrieve\nHybrid dense + sparse"]
        A3["Post-Retrieval\nRe-rank, compress, filter"]
        A4["Generate\nLLM with refined context"]
        A0 --> A1 --> A2 --> A3 --> A4
    end

    subgraph MODULAR["Modular RAG"]
        direction TB
        M1["Search Module\nPluggable retriever"]
        M2["Memory Module\nConversation state"]
        M3["Routing Module\nAdaptive pipeline"]
        M4["Predict Module\nLLM generation"]
        M5["Verify Module\nSelf-correction"]
        M1 --> M3
        M2 --> M3
        M3 --> M4
        M4 --> M5
        M5 -.->|"retry"| M3
    end

    NAIVE -->|"add pre/post\nprocessing"| ADVANCED
    ADVANCED -->|"modularize\ncomponents"| MODULAR

