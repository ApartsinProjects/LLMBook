flowchart TB
    subgraph ENCODER["Encoder hidden states"]
        H1["h₁<br/>'The'"]
        H2["h₂<br/>'cat'"]
        H3["h₃<br/>'sat'"]
        H4["h₄<br/>'on the mat'"]
    end

    DEC["Decoder state<br/>s_{t-1}<br/>(previous decoder hidden)"]

    subgraph SCORES["Step 1: alignment scores"]
        E1["e₁ = vᵀ tanh(W₁s_{t-1} + W₂h₁)"]
        E2["e₂ = vᵀ tanh(W₁s_{t-1} + W₂h₂)"]
        E3["e₃ = vᵀ tanh(W₁s_{t-1} + W₂h₃)"]
        E4["e₄ = vᵀ tanh(W₁s_{t-1} + W₂h₄)"]
    end

    SOFTMAX["Step 2: softmax<br/>α_i = exp(e_i) / Σ exp(e_j)"]

    subgraph WEIGHTS["Attention weights<br/>(sum to 1)"]
        A1["α₁ = 0.05"]
        A2["α₂ = 0.70"]
        A3["α₃ = 0.20"]
        A4["α₄ = 0.05"]
    end

    CONTEXT["Step 3: context vector<br/>c_t = Σ α_i · h_i"]

    DEC --> E1 & E2 & E3 & E4
    H1 --> E1
    H2 --> E2
    H3 --> E3
    H4 --> E4

    E1 --> SOFTMAX
    E2 --> SOFTMAX
    E3 --> SOFTMAX
    E4 --> SOFTMAX

    SOFTMAX --> A1 & A2 & A3 & A4

    A1 --> CONTEXT
    A2 --> CONTEXT
    A3 --> CONTEXT
    A4 --> CONTEXT
    H1 --> CONTEXT
    H2 --> CONTEXT
    H3 --> CONTEXT
    H4 --> CONTEXT

    style ENCODER fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style DEC fill:#fff3e0,stroke:#e65100,stroke-width:2.5px
    style SCORES fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style SOFTMAX fill:#fffde7,stroke:#f57f17,stroke-width:2.5px
    style WEIGHTS fill:#e0f2f1,stroke:#00695c,stroke-width:2px
    style A2 fill:#80cbc4,stroke:#004d40,stroke-width:2.5px
    style CONTEXT fill:#e8f5e9,stroke:#2e7d32,stroke-width:2.5px

    %% Caption hint: Bahdanau additive attention. At each decoder step, scores e_i are computed between the decoder state s_{t-1} and each encoder hidden state h_i via a small feed-forward network. Softmax produces alignment weights α_i (highlighted: α₂=0.70 means most attention goes to 'cat'). The context vector c_t is the weighted sum Σ α_i h_i, which is fed into the decoder.
