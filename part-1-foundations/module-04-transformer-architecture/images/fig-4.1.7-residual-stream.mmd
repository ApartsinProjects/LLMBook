flowchart LR
    INPUT["<b>x_embed</b>"]
    INPUT --> PLUS1

    subgraph LAYER1 ["<b>Layer 1</b>"]
        direction TB
        ATTN1["<b>Attn 1</b>"]
        FFN1["<b>FFN 1</b>"]
    end

    ATTN1 -.->|"read/write"| PLUS1(("+"))
    PLUS1 --> PLUS2(("+"))
    FFN1 -.->|"read/write"| PLUS2

    subgraph LAYER2 ["<b>Layer 2</b>"]
        direction TB
        ATTN2["<b>Attn 2</b>"]
        FFN2["<b>FFN 2</b>"]
    end

    PLUS2 --> PLUS3(("+"))
    ATTN2 -.->|"read/write"| PLUS3
    PLUS3 --> PLUS4(("+"))
    FFN2 -.->|"read/write"| PLUS4

    PLUS4 --> DOTS["<b>...</b>"]
    DOTS --> OUTPUT["<b>Output</b>"]

    style INPUT fill:#27ae60,stroke:#1e8449,color:#fff,stroke-width:2px
    style OUTPUT fill:#27ae60,stroke:#1e8449,color:#fff,stroke-width:2px

    style LAYER1 fill:#fafafa,stroke:#ccc,color:#1a1a2e
    style LAYER2 fill:#fafafa,stroke:#ccc,color:#1a1a2e

    style ATTN1 fill:#dbeafe,stroke:#3b82f6,color:#2563eb,stroke-width:1.5px
    style ATTN2 fill:#dbeafe,stroke:#3b82f6,color:#2563eb,stroke-width:1.5px
    style FFN1 fill:#fef3c7,stroke:#d97706,color:#92400e,stroke-width:1.5px
    style FFN2 fill:#fef3c7,stroke:#d97706,color:#92400e,stroke-width:1.5px

    style PLUS1 fill:#fff,stroke:#3b82f6,color:#3b82f6
    style PLUS2 fill:#fff,stroke:#d97706,color:#d97706
    style PLUS3 fill:#fff,stroke:#3b82f6,color:#3b82f6
    style PLUS4 fill:#fff,stroke:#d97706,color:#d97706
    style DOTS fill:none,stroke:none,color:#888
