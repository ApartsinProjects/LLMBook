flowchart LR
    WORD["<b>running</b>"]
    SPLIT["Split into<br/>character n-grams"]
    WORD --> SPLIT

    subgraph NGRAMS ["<b>Character 3-grams</b>"]
        direction LR
        N1["&lt;ru"]
        N2["run"]
        N3["unn"]
        N4["nni"]
        N5["nin"]
        N6["ing"]
        N7["ng&gt;"]
    end

    SPLIT --> NGRAMS
    SUM["<b>Sum all vectors</b>"]
    NGRAMS --> SUM
    RESULT["<b>v(running)</b><br/><i>Final word embedding</i>"]
    SUM --> RESULT

    style WORD fill:#1a1a2e,stroke:#0f3460,color:#fff,stroke-width:2px
    style SPLIT fill:#fff3e0,stroke:#e65100,color:#e65100
    style N1 fill:#e8f5e9,stroke:#2e7d32,color:#1e8449
    style N2 fill:#e8f5e9,stroke:#2e7d32,color:#1e8449
    style N3 fill:#e8f5e9,stroke:#2e7d32,color:#1e8449
    style N4 fill:#e8f5e9,stroke:#2e7d32,color:#1e8449
    style N5 fill:#e8f5e9,stroke:#2e7d32,color:#1e8449
    style N6 fill:#e8f5e9,stroke:#2e7d32,color:#1e8449
    style N7 fill:#e8f5e9,stroke:#2e7d32,color:#1e8449
    style NGRAMS fill:#f8fff8,stroke:#2e7d32,stroke-width:1px,color:#1a1a2e
    style SUM fill:#f3e5f5,stroke:#6a1b9a,color:#6a1b9a,stroke-width:2px
    style RESULT fill:#e94560,stroke:#c62828,color:#fff,stroke-width:2px
