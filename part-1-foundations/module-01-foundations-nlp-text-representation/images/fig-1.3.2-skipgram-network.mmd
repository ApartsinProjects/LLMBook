flowchart LR
    subgraph IN["Input layer"]
        OH["one-hot center word<br/>'sat'<br/>(V-dim, one 1, rest 0)"]
    end
    subgraph EMB["Hidden layer (no activation)"]
        H["embedding vector<br/>h = W · one_hot<br/>(d-dim, e.g. 300)"]
    end
    subgraph OUT["Output layer"]
        S["scores<br/>s = W' · h<br/>(V-dim)"]
        SM["softmax<br/>P(context | center)<br/>(V-dim)"]
    end

    OH -->|"row lookup<br/>in W"| H
    H -->|"dot product<br/>with each row of W'"| S
    S --> SM

    style IN fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style EMB fill:#fff3e0,stroke:#e65100,stroke-width:2px
    style OUT fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style OH fill:#bbdefb,stroke:#0d47a1,stroke-width:1.5px
    style H fill:#ffe0b2,stroke:#bf360c,stroke-width:1.5px
    style S fill:#c8e6c9,stroke:#1b5e20,stroke-width:1.5px
    style SM fill:#a5d6a7,stroke:#1b5e20,stroke-width:1.5px

    %% Caption hint: Skip-gram NN — multiply one-hot center word by embedding matrix W to look up the word's hidden vector h, then by W' and softmax to produce a probability distribution over context words.
