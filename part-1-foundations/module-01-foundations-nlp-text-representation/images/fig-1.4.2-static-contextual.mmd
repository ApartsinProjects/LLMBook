    subgraph CTX["Contextual (ELMo / BERT)"]
        direction TB
        C1["'bank' (money context)"] --> CV1["financial vector: [0.8, 0.2, ...]"]
        C2["'bank' (river context)"] --> CV2["riverbank vector: [-0.1, 0.7, ...]"]
        C3["'bank' (rely context)"] --> CV3["reliance vector: [0.4, -0.3, ...]"]
    end

    W --> STATIC
    W --> CTX

    style STATIC fill:#fce4ec,stroke:#c62828,stroke-width:2px
    style CTX fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
