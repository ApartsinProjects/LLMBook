flowchart TB
    C0["Step 0<br/>Corpus:<br/>'l o w </w>',<br/>'l o w e r </w>',<br/>'n e w e s t </w>'<br/>(each char is a token)"]

    C1["Step 1<br/>Most frequent pair: <b>l + o</b><br/>Merge: l o → lo<br/>Now: 'lo w', 'lo w e r', 'n e w e s t'"]

    C2["Step 2<br/>Most frequent pair: <b>lo + w</b><br/>Merge: lo w → low<br/>Now: 'low', 'low e r', 'n e w e s t'"]

    C3["Step 3<br/>Most frequent pair: <b>e + s</b><br/>Merge: e s → es<br/>Now: 'low', 'low e r', 'n e w es t'"]

    C4["Step 4<br/>Most frequent pair: <b>es + t</b><br/>Merge: es t → est<br/>Now: 'low', 'low e r', 'n e w est'"]

    DOT["⋮<br/>continue until target<br/>vocab size reached"]

    M["Merge table<br/>l o → lo<br/>lo w → low<br/>e s → es<br/>es t → est<br/>..."]

    C0 --> C1 --> C2 --> C3 --> C4 --> DOT
    DOT -.->|"records every<br/>merge in order"| M

    style C0 fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style C1 fill:#fff3e0,stroke:#e65100,stroke-width:2px
    style C2 fill:#fff3e0,stroke:#e65100,stroke-width:2px
    style C3 fill:#fff3e0,stroke:#e65100,stroke-width:2px
    style C4 fill:#fff3e0,stroke:#e65100,stroke-width:2px
    style DOT fill:none,stroke:none,color:#777
    style M fill:#e8f5e9,stroke:#2e7d32,stroke-width:2.5px

    %% Caption hint: BPE iteratively merges the most frequent character pair. The merge table records all merges in order so the same operations can be replayed at inference time.
