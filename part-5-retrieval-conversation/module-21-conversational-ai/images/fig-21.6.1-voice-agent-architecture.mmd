flowchart LR
    subgraph PIPELINE["<b>Voice Pipeline (Simple)</b>"]
        direction LR
        P1["<b>STT</b><br/><i>Speech to text</i>"]
        P2["<b>LLM</b><br/><i>Single call</i>"]
        P3["<b>TTS</b><br/><i>Text to speech</i>"]
        P1 --> P2 --> P3
    end

    subgraph AGENT["<b>Voice Agent (Agentic)</b>"]
        direction LR
        A1["<b>STT</b><br/><i>Whisper, Deepgram</i>"]

        subgraph LOOP["<b>Agent Loop</b>"]
            direction TB
            A2["<b>LLM Reasoning</b>"]
            A3["<b>Tool Calls</b><br/><i>APIs, databases,<br/>booking systems</i>"]
            A4["<b>Compose Response</b>"]
            A2 --> A3 --> A4
            A4 -.->|"if more needed"| A2
        end

        A5["<b>TTS</b><br/><i>Streaming output</i>"]
        A1 --> LOOP --> A5
    end

    subgraph LATENCY["<b>Latency Management</b>"]
        direction TB
        L1["Progressive responses"]
        L2["Filler speech"]
        L3["Parallel tool calls"]
    end

    AGENT -.-> LATENCY

    style PIPELINE fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style AGENT fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style LOOP fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style LATENCY fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px,color:#1a1a2e
