flowchart LR
    subgraph GRAPHRAG["<b>GraphRAG Pipeline (Edge et al., 2024)</b>"]
        direction LR

        DOCS["<b>Documents</b><br/><i>Raw text corpus</i>"]

        subgraph INDEXING["<b>Indexing Phase</b>"]
            direction LR
            EXTRACT["<b>LLM Entity<br/>Extraction</b><br/><i>Entities and relations<br/>from each chunk</i>"]
            KG["<b>Knowledge Graph</b><br/><i>Unified entity-relation<br/>network</i>"]
            LEIDEN["<b>Leiden Community<br/>Detection</b><br/><i>Cluster densely<br/>connected entities</i>"]
            SUMMARIES["<b>Community<br/>Summaries</b><br/><i>LLM summarizes<br/>each cluster</i>"]
        end

        subgraph QUERY["<b>Query Phase</b>"]
            direction TB
            Q["<b>User Query</b>"]
            ROUTE["<b>Query Router</b><br/><i>Local or Global?</i>"]
            LOCAL["<b>Local Search</b><br/><i>Entity neighbors +<br/>related text chunks</i>"]
            GLOBAL["<b>Global Search</b><br/><i>Map-reduce over<br/>community summaries</i>"]
            ANS["<b>Answer</b>"]

            Q --> ROUTE
            ROUTE -->|"specific<br/>question"| LOCAL
            ROUTE -->|"broad<br/>question"| GLOBAL
            LOCAL --> ANS
            GLOBAL --> ANS
        end
    end

    DOCS -->|"chunk"| EXTRACT
    EXTRACT -->|"triples"| KG
    KG -->|"graph"| LEIDEN
    LEIDEN -->|"clusters"| SUMMARIES
    KG -.->|"entities"| LOCAL
    SUMMARIES -.->|"summaries"| GLOBAL

    style DOCS fill:#1a1a2e,stroke:#0f3460,stroke-width:2px,color:#fff
    style EXTRACT fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style KG fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style LEIDEN fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style SUMMARIES fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px,color:#1a1a2e
    style Q fill:#1a1a2e,stroke:#0f3460,stroke-width:2px,color:#fff
    style ROUTE fill:#fce4ec,stroke:#c62828,stroke-width:2px,color:#1a1a2e
    style LOCAL fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style GLOBAL fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px,color:#1a1a2e
    style ANS fill:#1a1a2e,stroke:#0f3460,stroke-width:2px,color:#fff
    style GRAPHRAG fill:#fafafa,stroke:#999,stroke-width:1px,color:#1a1a2e
    style INDEXING fill:#f5f5f5,stroke:#ccc,stroke-width:1px,color:#1a1a2e
    style QUERY fill:#fff8f0,stroke:#e65100,stroke-width:1px,color:#1a1a2e
