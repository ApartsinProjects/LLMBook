flowchart TB
    subgraph INDEXING["<b>GraphRAG Indexing Pipeline</b>"]
        direction LR
        D["<b>Documents</b><br/><i>Unstructured corpus</i>"]
        S1["<b>1. Entity &amp;<br/>Relation Extraction</b><br/><i>LLM per chunk</i>"]
        S2["<b>2. Graph Construction<br/>&amp; Merging</b><br/><i>Coreference resolution</i>"]
        S3["<b>3. Community<br/>Detection</b><br/><i>Leiden algorithm</i>"]
        S4["<b>4. Community<br/>Summarization</b><br/><i>LLM per community</i>"]
        D --> S1 --> S2 --> S3 --> S4
    end

    S4 --> KG["<b>Knowledge Graph</b><br/><i>Entities + Communities<br/>+ Summaries</i>"]

    subgraph QUERY["<b>Query Modes</b>"]
        direction LR
        subgraph LOCAL["<b>Local Search</b>"]
            QL["Query entities<br/>Graph neighborhood<br/>Associated chunks"]
        end
        subgraph GLOBAL["<b>Global Search</b>"]
            QG["Map: score all<br/>community summaries<br/>Reduce: synthesize answer"]
        end
    end

    KG --> LOCAL
    KG --> GLOBAL

