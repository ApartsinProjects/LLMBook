flowchart LR
    subgraph SOURCES["<b>Data Sources</b>"]
        direction TB
        S1["Confluence"]
        S2["Google Drive"]
        S3["Slack"]
        S4["PostgreSQL"]
        S5["SharePoint"]
    end

    subgraph CONNECTORS["<b>Connectors</b>"]
        C1["<b>Auth + Extract</b><br/><i>OAuth, API keys<br/>Change tracking<br/>Rate limiting</i>"]
    end

    subgraph PARSE["<b>Parsing</b>"]
        P1["<b>Document Parsing</b><br/><i>PDF tables, HTML<br/>Markdown, images<br/>OCR for scans</i>"]
    end

    subgraph CHUNK["<b>Chunking</b>"]
        CH1["<b>Strategy Selection</b><br/><i>Semantic, recursive,<br/>document-aware<br/>with overlap</i>"]
    end

    subgraph EMBED["<b>Embed + Index</b>"]
        direction TB
        E1["<b>Embedding Model</b><br/><i>Generate vectors</i>"]
        E2["<b>Vector Database</b><br/><i>Store + metadata</i>"]
    end

    subgraph SCHEDULE["<b>Orchestration</b>"]
        O1["<b>Scheduled Sync</b><br/><i>Nightly batch +<br/>incremental updates</i>"]
    end

    SOURCES --> CONNECTORS --> PARSE --> CHUNK --> EMBED
    SCHEDULE -.->|"triggers"| CONNECTORS

