flowchart LR
    subgraph USER["<b>User</b>"]
        U["<b>Employee</b><br/><i>Sales team member</i>"]
    end

    subgraph IDP["<b>Identity Provider</b>"]
        AUTH["<b>OIDC / SAML</b><br/><i>Authenticate + issue token<br/>Claims: role, dept, tenant</i>"]
    end

    subgraph LLMAPP["<b>LLM Application</b>"]
        direction TB
        VAL["<b>Validate Token</b><br/><i>Check signature, expiry</i>"]
        RBAC["<b>RBAC Check</b><br/><i>User role &#8594; allowed tools</i>"]
        LLM["<b>LLM Call</b><br/><i>Scoped system prompt</i>"]
    end

    subgraph TOOLS["<b>External Tools</b>"]
        direction TB
        CRM["<b>CRM API</b><br/><i>User's OAuth token<br/>sees only own accounts</i>"]
        DB["<b>Database</b><br/><i>Row-level security<br/>tenant isolation</i>"]
    end

    subgraph AUDIT["<b>Audit Trail</b>"]
        LOG["<b>Compliance Log</b><br/><i>Who, what, when,<br/>which data accessed</i>"]
    end

    U --> AUTH
    AUTH -->|"access token"| VAL
    VAL --> RBAC --> LLM
    LLM -->|"token passthrough"| TOOLS
    TOOLS --> LOG
    LLM --> LOG

    style USER fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px,color:#1a1a2e
    style IDP fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style LLMAPP fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style TOOLS fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style AUDIT fill:#1a1a2e,stroke:#0f3460,stroke-width:2px,color:#fff
