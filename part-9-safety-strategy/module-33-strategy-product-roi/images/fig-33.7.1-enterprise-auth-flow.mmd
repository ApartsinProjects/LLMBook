flowchart TD
    subgraph USER["**User**"]
        U["**Employee**\nSales team member"]
    end

    subgraph IDP["**Identity Provider**"]
        AUTH["**OIDC / SAML**\nAuthenticate + issue token\nClaims: role, dept, tenant"]
    end

    subgraph LLMAPP["**LLM Application**"]
        direction TB
        VAL["**Validate Token**\nCheck signature, expiry"]
        RBAC["**RBAC Check**\nUser role: allowed tools"]
        LLM["**LLM Call**\nScoped system prompt"]
    end

    subgraph TOOLS["**External Tools**"]
        direction TB
        CRM["**CRM API**\nUser OAuth token\nsees only own accounts"]
        DB["**Database**\nRow-level security\ntenant isolation"]
    end

    subgraph AUDIT["**Audit Trail**"]
        LOG["**Compliance Log**\nWho, what, when,\nwhich data accessed"]
    end

    U --> AUTH
    AUTH -->|"access token"| VAL
    VAL --> RBAC --> LLM
    LLM -->|"token passthrough"| TOOLS
    TOOLS --> LOG
    LLM --> LOG

    style USER fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px,color:#1a1a2e
