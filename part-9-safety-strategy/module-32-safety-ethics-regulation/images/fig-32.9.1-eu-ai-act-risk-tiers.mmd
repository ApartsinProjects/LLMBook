flowchart TB
    subgraph PYRAMID["<b>EU AI Act Risk Classification</b>"]
        direction TB
        P["<b>PROHIBITED</b><br/><i>Social scoring, subliminal<br/>manipulation, real-time<br/>biometric ID</i>"]
        H["<b>HIGH RISK</b><br/><i>Employment, education,<br/>credit scoring, law enforcement,<br/>migration, justice</i>"]
        L["<b>LIMITED RISK</b><br/><i>Customer-facing chatbots,<br/>AI-generated content</i>"]
        M["<b>MINIMAL RISK</b><br/><i>Spam filters, code completion,<br/>internal tools</i>"]
        P --> H --> L --> M
    end

    subgraph OBLIGATIONS["<b>Compliance Obligations</b>"]
        direction TB
        O1["<b>Banned</b><br/><i>Cannot deploy in EU</i>"]
        O2["<b>Full Compliance</b><br/><i>Risk management, data governance,<br/>technical documentation,<br/>conformity assessment, logging</i>"]
        O3["<b>Transparency Only</b><br/><i>Disclose AI interaction,<br/>label AI-generated content</i>"]
        O4["<b>No Obligations</b><br/><i>General product safety law</i>"]
    end

    P -.-> O1
    H -.-> O2
    L -.-> O3
    M -.-> O4

    style PYRAMID fill:#fff,stroke:#555,stroke-width:1px,color:#1a1a2e
    style OBLIGATIONS fill:#fff,stroke:#555,stroke-width:1px,color:#1a1a2e
    style P fill:#fce4ec,stroke:#c62828,stroke-width:2px,color:#1a1a2e
    style H fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#1a1a2e
    style L fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style M fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style O1 fill:#fce4ec,stroke:#c62828,stroke-width:1px,color:#1a1a2e
    style O2 fill:#fff3e0,stroke:#e65100,stroke-width:1px,color:#1a1a2e
    style O3 fill:#e3f2fd,stroke:#1565c0,stroke-width:1px,color:#1a1a2e
    style O4 fill:#e8f5e9,stroke:#2e7d32,stroke-width:1px,color:#1a1a2e
