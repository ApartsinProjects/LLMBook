flowchart LR
    subgraph CONTINUOUS["1. Continuous-Time View"]
        direction TB
        CT1["dx/dt = Ax + Bu\nState evolves continuously"]
        CT2["y = Cx + Du\nOutput from state"]
        CT3["A, B, C, D matrices\nA initialized via HiPPO"]
        CT1 --- CT2 --- CT3
    end

    subgraph RECURRENT["2. Recurrent View"]
        direction TB
        REC1["x_k = A_bar * x_{k-1} + B_bar * u_k\nUpdate hidden state"]
        REC2["y_k = C * x_k + D * u_k\nProduce output"]
        REC3["O(1) per step\nConstant memory at inference"]
        REC1 --- REC2 --- REC3
    end

    subgraph CONV["3. Convolutional View"]
        direction TB
        CV1["K = (CB, CAB, CA^2B, ...)\nPrecompute convolution kernel"]
        CV2["y = K * u\nConvolve kernel with input"]
        CV3["O(n log n) via FFT\nParallel over full sequence"]
        CV1 --- CV2 --- CV3
    end

    CONTINUOUS -->|"discretize with\nstep size delta"| RECURRENT
    RECURRENT -->|"unroll recurrence\ninto convolution"| CONV

    style CT1 fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style CT2 fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style CT3 fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#1a1a2e
    style REC1 fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style REC2 fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style REC3 fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1a1a2e
    style CV1 fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px,color:#1a1a2e
    style CV2 fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px,color:#1a1a2e
    style CV3 fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px,color:#1a1a2e
