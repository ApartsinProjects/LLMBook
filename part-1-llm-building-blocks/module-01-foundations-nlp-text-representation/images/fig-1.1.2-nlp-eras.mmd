flowchart TB
    subgraph ROW1[" "]
        direction LR
        R["**Rule-Based Era**\n1950s to 1980s\nHand-written grammar rules\nand pattern matching"]
        S["**Statistical Era**\n1990s to 2000s\nWord counts, n-grams,\nprobabilistic models"]
        R -->|"breakthrough:\nstatistical learning"| S
    end
    subgraph ROW2[" "]
        direction LR
        N["**Neural Era**\n2013 to 2017\nWord2Vec, dense vectors,\nend-to-end learning"]
        L["**LLM Era**\n2017 to Present\nTransformers, contextual\nvectors, foundation models"]
        N -->|"breakthrough:\nself-attention"| L
    end

    S -->|"breakthrough:\nneural representations"| N

    style R fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style S fill:#fff3e0,stroke:#e65100,stroke-width:2px
    style N fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style L fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style ROW1 fill:none,stroke:none
    style ROW2 fill:none,stroke:none
