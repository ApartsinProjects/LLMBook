flowchart LR
    EMB["Token + Position\nEmbedding"]

    subgraph BLOCK["Transformer Block (x N)"]
        direction TB
        LN1["LayerNorm"] --> ATT["Causal Multi-Head\nSelf-Attention"]
        ATT --> RES1["+ residual"]
        RES1 --> LN2["LayerNorm"]
        LN2 --> FFN["Feed-Forward\n(SwiGLU or ReLU)"]
        FFN --> RES2["+ residual"]
    end

    FLN["Final\nLayerNorm"]
    LIN["Linear\n(d_model to vocab)"]
    SM["Softmax\nnext token probs"]

    EMB --> BLOCK --> FLN --> LIN --> SM

    style EMB fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style BLOCK fill:#fff3e0,stroke:#e65100,stroke-width:1px
    style FLN fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style SM fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
