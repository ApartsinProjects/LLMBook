flowchart TB
    LOSS["<b>Loss L</b>"]
    CTX["<b>context = Sum(alpha * h)</b>"]
    ALPHA["<b>alpha = softmax(scores)</b>"]

    LOSS --> CTX
    CTX -->|"direct path<br/>(gradient scaled by alpha)"| H1
    CTX -->|"strong signal"| H2
    CTX -->|"direct path"| H3
    CTX -->|"moderate signal"| H4
    CTX --> ALPHA
    ALPHA -.->|"indirect path<br/>(score function)"| H2
    ALPHA -.->|"indirect path"| H3

    subgraph STATES ["<b>Encoder Hidden States</b>"]
        direction LR
        H1["<b>h1</b>"]
        H2["<b>h2</b>"]
        H3["<b>h3</b>"]
        H4["<b>h4</b>"]
    end

    style LOSS fill:#e94560,stroke:#c62828,color:#fff,stroke-width:2px
    style CTX fill:#27ae60,stroke:#1e8449,color:#fff,stroke-width:2px
    style ALPHA fill:#f39c12,stroke:#e67e22,color:#fff
    style STATES fill:#f8f9fa,stroke:#ccc,color:#1a1a2e

    style H1 fill:#4a90d9,stroke:#2c6fbb,color:#fff
    style H2 fill:#4a90d9,stroke:#2c6fbb,color:#fff
    style H3 fill:#4a90d9,stroke:#2c6fbb,color:#fff
    style H4 fill:#4a90d9,stroke:#2c6fbb,color:#fff
