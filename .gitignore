# Persistent temp HTML used by KDP/build/build_sample_pdf.py for Edge headless rendering
**/tmppdf.html

# Bundled JRE + EPUBCheck for QA pipeline (~80 MB; downloadable from Adoptium + W3C).
# Install via: KDP/build/install_qa_tools.sh
KDP/build/tools/

# Backup snapshots from build/audit fix scripts (113+ MB, redundant with git history)
KDP/build/source_fix_backups/

# Python bytecode
**/__pycache__/
*.pyc

# In-place file backups created by audit/fix scripts
*.bak
*.bak2
*.bak3
*.dup-drop

# OS junk
.DS_Store
Thumbs.db

# Temporary EPUB scratch dir from build_epub.py
temp_epub/

# Node modules (KaTeX, mermaid-cli, pagefind, etc — all reinstallable from
# package.json / explicit npm install commands documented in skill files)
**/node_modules/

# Editable-install metadata
**/*.egg-info/

# Stale build artifact (kept by html2pub before EPUB final assembly)
KDP/output/*.raw.epub

# html2pub image cache (re-derivable from source images)
.html2pub_cache/

# EPUB build outputs (large binary, publish via GitHub Releases instead)
KDP/output/*.epub

# npm lockfile is regenerated locally; not required for deploy
package-lock.json

# Build/optimize logs (timestamped, regenerated each run)
KDP/build/logs/

# Kindle Previewer bisect / convert outputs (transient, regenerated by script)
KDP/output/_bisect/
KDP/output/output/

# JVM crash dumps from epubcheck / Kindle Previewer
hs_err_pid*.log

# Exploratory validation outputs (regenerated by audit scripts)
KDP/validation/pandoc_test.html
KDP/validation/duplicate_content.csv

# Claude Code harness session lock (transient, per-session)
.claude/scheduled_tasks.lock
replay_pid*.log
KDP/build/_kp_bisect.py
KDP/build/audit_thumbs/

# Transient agent review reports (regenerated by run_qa_pipeline.py / agent runs;
# value is in the changes they motivate, not the reports themselves).
KDP/build/_agent_reports/

# Per-section currency / numbering audit reports (regenerated each pipeline run)
KDP/build/_v712_currency_report.md
