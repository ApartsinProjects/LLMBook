# Secrets and API keys (NEVER commit; load via dotenv or os.environ at runtime)
.env
.env.*
**/.env
**/.env.*

# Persistent temp HTML used by KDP/build/build_sample_pdf.py for Edge headless rendering
**/tmppdf.html

# Bundled JRE + EPUBCheck for QA pipeline (~80 MB; downloadable from Adoptium + W3C).
# Install via: KDP/build/install_qa_tools.sh
KDP/build/tools/

# Backup snapshots from build/audit fix scripts (113+ MB, redundant with git history)
KDP/build/source_fix_backups/

# Python bytecode
**/__pycache__/
*.pyc

# In-place file backups created by audit/fix scripts
*.bak
*.bak2
*.bak3
*.dup-drop

# Skill junctions to ApartsinProjects/claude-skills (single source of truth).
# These paths are NTFS directory junctions to E:/Projects/claude-skills/<skill>.
# Tracked content lives in the claude-skills repo, NOT here. To bootstrap a
# fresh clone of LLMBook, also clone claude-skills next to it and run:
#   cmd /c mklink /J agents\book-skills E:\Projects\claude-skills\book-skills
#   cmd /c mklink /J KDP\html2epub      E:\Projects\claude-skills\html2epub
agents/book-skills/
KDP/html2epub/

# Pre-junction backups of the dirs we replaced with junctions (kept locally
# for rollback safety; not worth tracking).
KDP/build/_junction_replaced_backup/

# Per-run output dirs from KPV3 / direct-jar diagnostic runs (large, transient)
KDP/output/kpv-debug/
KDP/output/kpv-direct/
KDP/output/kpv-maximal/
KDP/output/kpv-repair/
KDP/output/kpv-retry/
KDP/output/uploads/

# KPR.Log + crash dump backups from KPV3 troubleshooting (large)
KDP/build/_kpv_debug_archive/

# Temp scratch python (underscore-prefixed = internal/throwaway)
KDP/build/_*.py

# Per-agent transient audit snapshots (not part of book content)
.book-update/

# Portable diagramming tool binaries (Graphviz, D2) + pilot render scratch.
# Reinstallable: see scripts/diagrams/ (download + pip install commands).
.tools/

# OS junk
.DS_Store
Thumbs.db

# Temporary EPUB scratch dir from build_epub.py
temp_epub/

# Node modules (KaTeX, mermaid-cli, pagefind, etc — all reinstallable from
# package.json / explicit npm install commands documented in skill files)
**/node_modules/

# Editable-install metadata
**/*.egg-info/

# Stale build artifact (kept by html2epub before EPUB final assembly)
KDP/output/*.raw.epub

# html2epub image cache (re-derivable from source images)
.html2epub_cache/

# EPUB build outputs (large binary, publish via GitHub Releases instead)
KDP/output/*.epub

# npm lockfile is regenerated locally; not required for deploy
package-lock.json

# Build/optimize logs (timestamped, regenerated each run)
KDP/build/logs/

# Kindle Previewer bisect / convert outputs (transient, regenerated by script)
KDP/output/_bisect/
KDP/output/output/

# JVM crash dumps from epubcheck / Kindle Previewer
hs_err_pid*.log

# Exploratory validation outputs (regenerated by audit scripts)
KDP/validation/pandoc_test.html
KDP/validation/duplicate_content.csv

# Claude Code harness session lock (transient, per-session)
.claude/scheduled_tasks.lock
replay_pid*.log
KDP/build/_kp_bisect.py
KDP/build/audit_thumbs/

# Transient agent review reports (regenerated by run_qa_pipeline.py / agent runs;
# value is in the changes they motivate, not the reports themselves).
KDP/build/_agent_reports/

# Per-section currency / numbering audit reports (regenerated each pipeline run)
KDP/build/_v712_currency_report.md

# KPF files are >100MB (GitHub limit); produced by Kindle Previewer manually
KDP/output/*.kpf
KDP/output/*.mobi
KDP/output/output/
KDP/output/_recompress_temp/
KDP/output/_bisect/
# Kindle Previewer KFX validation output (publish.py step_kpv): KPF/, Logs/,
# Summary_Log.csv -- regenerated every build, not for version control.
KDP/output/kpv-out/
audit.json

# slide-summaries: cache + transient run state (the .md files themselves ARE committed)
slide-summaries/_downloads/
slide-summaries/_batch_manifest.json
slide-summaries/_batch_results.json
slide-summaries/_part*_manifest.json
slide-summaries/_part*_targets.json
slide-summaries/_part*_batch_results.json
slide-summaries/_part*_summary_gen_results.json
KDP/validation/kpv_ed16/
KDP/output/*.kpf
KDP/validation/kpv_post_xhtml/
.claude/
